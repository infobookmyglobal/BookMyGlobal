# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=info@bookmyglobal.com
# Digits only incl. country code, e.g. 919876543210. Leave blank to hide WhatsApp links.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SUPPORT_PHONE=
# Shown in the legal pages (Terms, Privacy, Refunds). Fill in your registered business details.
NEXT_PUBLIC_COMPANY_NAME=BookMyGlobal
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_GRIEVANCE_OFFICER=

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/bookmyglobal?schema=public

# ── Clerk (NEW application for BookMyGlobal) ──────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOURS
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_YOURS
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# Svix signing secret of the Clerk webhook endpoint (/api/webhooks/clerk)
CLERK_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOURS

# ── Admin ─────────────────────────────────────────────────────────────────────
# Comma-separated. Anyone signing in with these emails is auto-promoted to ADMIN
# and receives admin alert emails.
ADMIN_EMAIL=you@example.com
# Password asked when unlocking the sensitive admin sections (server-verified).
ADMIN_UNLOCK_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# Signs the unlock cookie. Generate with: openssl rand -hex 32  (falls back to CLERK_SECRET_KEY)
ADMIN_UNLOCK_SECRET=

# ── AWS (NEW account/IAM user for BookMyGlobal) ───────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_YOURS
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_YOURS
AWS_S3_BUCKET_NAME=bookmyglobal-uploads
# CloudFront distribution domain WITHOUT https://, e.g. d111111abcdef8.cloudfront.net
AWS_CLOUDFRONT_DOMAIN=REPLACE_WITH_YOURS.cloudfront.net
NEXT_PUBLIC_CLOUDFRONT_DOMAIN=REPLACE_WITH_YOURS.cloudfront.net

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_REPLACE_WITH_YOURS
# Must be on a domain verified in Resend
EMAIL_FROM=info@bookmyglobal.com

# ── Payments ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox            # sandbox | production
PAYPAL_WEBHOOK_ID=            # required: webhooks are rejected without it

# ── Shipping (ShipGlobal) ─────────────────────────────────────────────────────
SHIPGLOBAL_API_KEY=
SHIPGLOBAL_EMAIL=
SHIPGLOBAL_PASSWORD=
SHIPGLOBAL_DEFAULT_SERVICE=
SHIPGLOBAL_WEBHOOK_SECRET=    # required: webhooks are rejected without it

# ── Optional ──────────────────────────────────────────────────────────────────
EXCHANGE_RATE_API_KEY=
